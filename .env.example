# Необязательно для публичных репозиториев.
GITHUB_TOKEN=

# LLM на MCP-сервере: используется только инструментом summarize.
# Ключ не передаётся агенту; без него остальные инструменты продолжают работать.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Относительный путь считается от каталога MCPServerExample; можно задать абсолютный.
MCP_OUTPUT_DIR=output

# Локальный запуск / VPS с HTTPS reverse proxy на той же машине.
# Для proxy в другой сети задайте 0.0.0.0; порт разрешите только для proxy.
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Отдельный секрет для доступа агента к MCP (не GitHub-токен).
# На VPS обязателен и при MCP_HOST=127.0.0.1 за reverse proxy.
MCP_ACCESS_TOKEN=
# Разрешённые Host headers, через запятую; для VM добавьте её DNS-имя/IP с портом.
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
# Нужно только для клиентов, отправляющих Origin header.
MCP_ALLOWED_ORIGINS=
